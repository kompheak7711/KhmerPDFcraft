{
  "name": "khmerpdfcraft",
  "private": true,
  "version": "0.1.0",
  "description": "A small PDF editor that lets you type Khmer Unicode text onto PDF pages with any Khmer font: bundled, uploaded, or installed on your Mac.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "dist:desktop": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "harfbuzzjs": "^1.6.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.kompheak.khmerpdfcraft",
    "productName": "KhmerPDFcraft",
    "copyright": "Fonts under the SIL Open Font License; see public/fonts/OFL.txt",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "kompheak7711"
    }
  },
  "author": "kompheak7711"
}
